# Copy to .env and adjust if needed:  cp .env.example .env

# Postgres (used by the db container and the backend)
POSTGRES_USER=aphelion
POSTGRES_PASSWORD=aphelion_dev
POSTGRES_DB=aphelion
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Inside compose the backend reaches the db by service name "db"
DATABASE_URL=postgresql+psycopg://aphelion:aphelion_dev@db:5432/aphelion

# Frontend
FRONTEND_PORT=5173
